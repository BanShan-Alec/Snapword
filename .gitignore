# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
out/
build/
release/
*.exe
*.msi
*.nsis
*.asar
# 例外：build/ 是 electron-builder 配置与品牌图标目录，随仓提交
!/build/
!/build/**

# 测试与工具产物
playwright-report/
test-results/
*.tsbuildinfo
.husky/_/

# 宿主进程（C# / Rust）中间产物
bin/
obj/
target/
*.pdb

# 配置与密钥
config.json
config.bak
*.key
*.pem
# .env 按 temp5 约定入库（DSN 是客户端标识，不是服务端密钥）；本地覆盖用 .env.local
.env.local
.env.*.local
!/.env.example

# 本地数据
*.db
*.db-journal
*.corrupt.db
logs/
vocab.db

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 编辑器
.vscode/
!.vscode/extensions.json
.idea/
*.swp
