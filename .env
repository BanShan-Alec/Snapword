# Snapword 环境配置（与 temp5 约定一致：本文件入库；本地覆盖用 .env.local）
# 说明：这里的值会在构建期被 Vite 读取并注入；外部同名环境变量优先级更高。

ENV_PREFIX=APP_
DISTRIBUTION_CHANNEL=latest

# Sentry：仅生产打包（app.isPackaged）且 DSN 非空时启用。
# DSN 是客户端标识（会出现在客户端产物中），不是服务端密钥；AUTH_TOKEN 仍只放 GitHub Secrets。
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# 系统标识：注入运行时快照的 systemCode（不含端点/密钥）
SYSTEM_CODE=ELECTRON_APP

# 构建质量阈值：主进程 asar 体积上限（MB）
MAX_ASAR_SIZE_MB=10

# Vite 配置加载警告抑制（与 temp5 一致）
VITE_CONFIG_NATIVE_IGNORE_WARNING=true
