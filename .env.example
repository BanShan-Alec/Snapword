# ==============================================================================
# 应用环境变量统一前缀 (供外部动态覆盖使用，例如 APP_SYSTEM_CODE)
# ==============================================================================
ENV_PREFIX=APP_

# ==============================================================================
# 运行时语义与模式控制 (由 package.json 脚本自动注入，通常无需手动修改)
# 可选值: development (本地开发调试) | production (生产预览行为) | test (自动化测试)
# ==============================================================================
# MODE=development

# ==============================================================================
# 发布通道 (生产打包与 OTA 在线更新)
# 发布源 owner/repo 由根目录 package.json 的 repository.url 解析，不再支持 .env 覆盖
# ==============================================================================
DISTRIBUTION_CHANNEL=latest

# ==============================================================================
# 系统标识（模板扩展点：注入 window.__APP_ENV__ 的 systemCode；不含任何端点/密钥）
# ==============================================================================
SYSTEM_CODE=ELECTRON_APP

# ==============================================================================
# CI 门禁 / 构建质量防护阈值
# ==============================================================================
# 主进程 asar 打包体积防劣化阈值 (单位: MB，默认 10)
MAX_ASAR_SIZE_MB=10

# ==============================================================================
# 本地 / CI 构建控制
# ==============================================================================
# 忽略 Vite 原生配置加载警告（Vite config loader 内置读取，单位: 布尔值 true | false）
VITE_CONFIG_NATIVE_IGNORE_WARNING=true

# ==============================================================================
# 🔐 GitHub Repository Secrets 配置清单 (切勿写入本地 .env，应配置于 GitHub 仓库)
# 配置路径: 仓库 Settings -> Secrets and variables -> Actions -> New repository secret
# ==============================================================================
#
# 1. AI 自动化代码审查 (OpenCodeReview) 凭证:
#    - OCR_LLM_URL: 兼容 OpenAI 格式的大模型 API 端点 (例如 https://api.deepseek.com/v1 或 https://api.openai.com/v1)
#    - OCR_LLM_TOKEN: 大模型 API 访问密钥 (API Key)
#    - OCR_LLM_MODEL: 评审采用的模型名称 (例如 deepseek-chat 或 gpt-4o)
#    CI 使用位置: .github/workflows/open-code-review.yml
#
# 2. 发布与权限凭证:
#    - GH_TOKEN / GITHUB_TOKEN: GitHub Releases 发版上传产物与 PR CLI 交互凭证。
#      CI 内部默认自动注入 ${{ secrets.GITHUB_TOKEN }} (需赋予 contents: write 权限)。
#      若发版需跨仓库操作或触发其他下游 Actions，可在 Secrets 中配置带有 repo 权限的个人访问令牌 (PAT)。
#
# 3. 跨平台原生代码签名证书 (选填，用于消除安装报毒与通过 Apple 公证):
#    - macOS:
#      - APPLE_ID: Apple 开发者账号邮箱
#      - APPLE_APP_SPECIFIC_PASSWORD: Apple ID 专用应用密码 (https://appleid.apple.com 生成)
#      - APPLE_TEAM_ID: Apple 开发者 10 位 Team ID
#      - CSC_LINK: Developer ID Application 证书文件 Base64 编码字符串或下载链接 (.p12)
#      - CSC_KEY_PASSWORD: 证书解密密码
#    - Windows:
#      - CSC_LINK: 代码签名证书 Base64 字符串 (.pfx)
#      - CSC_KEY_PASSWORD: 证书私钥密码
#      (或采用微軟推荐的 Azure Trusted Signing 相关云端签名环境变量)
# ==============================================================================
